# Optional browser Firebase config (only public Firebase web config belongs here)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Configure server-side secrets using Firebase Secret Manager / Functions secrets.
# Do not put an LLM API key in a NEXT_PUBLIC_ variable.
LLM_API_KEY=
LLM_MODEL=
